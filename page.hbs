{{!--
Generic page (« Mentions légales », any static page): a calm reading column. The title, the excerpt and
the feature image show unless the page's « Show title and feature image » setting is off
(@page.show_title_and_feature_image); the text uses the reading font and Ghost's cards keep their
widths (wide, full). An empty page body shows nothing more than its heading.
--}}

{{#contentFor "preload"}}
  <link rel="preload" href="{{asset "css/page.css"}}" as="style" />
  <link rel="modulepreload" href="{{asset "js/page.js"}}" />
{{/contentFor}}

{{#contentFor "styles"}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/page.css"}}" media="screen" />
{{/contentFor}}

{{!< default}}

{{> header}}

<main id="main" class="site-main page-main">
  {{#post}}
    <article class="page-article">
      {{#match @page.show_title_and_feature_image}}
        <header class="page-article__header">
          <h1 class="page-article__title">{{title}}</h1>
          {{#if custom_excerpt}}<p class="page-article__excerpt">{{custom_excerpt}}</p>{{/if}}
        </header>
        {{#if feature_image}}
          <figure class="page-article__figure">
            <img class="page-article__image" srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 1100px) 100vw, 1040px" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" fetchpriority="high">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
          </figure>
        {{/if}}
      {{else}}
        <h1 class="sr-only">{{title}}</h1>
      {{/match}}
      <div class="page-content gh-content js-post-content">
        {{content}}
      </div>
    </article>
  {{/post}}
</main>

{{#contentFor "scripts"}}
  <script type="module" src="{{asset "js/page.js"}}"></script>
{{/contentFor}}
