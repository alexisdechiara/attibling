<!DOCTYPE html>
{{!-- data-member: a signed-in member (members-only features in the scripts, src/js/store.js);
data-consent: the fallback consent mode of the theme setting consent_notice (src/js/privacy/choices.js) --}}
<html lang="{{@site.locale}}"{{#if @member}} data-member{{/if}}{{#match @custom.consent_notice "Notice"}} data-consent="notice"{{/match}}{{#match @custom.consent_notice "Banner"}} data-consent="banner"{{/match}}>
  <head>
    {{!-- Document Settings --}}
    <meta charset="utf-8" />

    {{!-- Base Meta --}}
    <title>{{{block "title"}}}{{meta_title}}</title>
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark">
    {{!-- Single-author site: the author page repeats the home's list, keep it out of search results --}}
    {{#is "author"}}{{#get "authors" limit="1" fields="id" as |siteAuthors authorPages|}}{{#match authorPages.total 1}}<meta name="robots" content="noindex, follow" />{{/match}}{{/get}}{{/is}}

    {{!-- Preload assets --}}
    <link rel="preload" href="{{asset "css/app.css"}}" as="style" />
    <link rel="modulepreload" href="{{asset "js/app.js"}}" />

    {{!-- This #block helper will try to preload page-specific assets --}}
    {{{block "preload"}}}

    {{!-- Before the first paint: the theme mode (data-theme light | dark, from localStorage "theme",
    "auto" or nothing following the system), and the home subscription block closed for good
    (data-promo-closed, localStorage "attibling-promo-closed"); on article pages, the members' display
    settings (data-reading-*, localStorage "attibling-reading", see src/js/reading-settings.js). --}}
    <script>
      // @license magnet:?xt=urn:btih:d3d9a9a6595521f9666a5e94cc830dab83b65699&dn=expat.txt Expat
      (function () {
        var root = document.documentElement
        // Scripts run: the CSS may hide what they will show (e.g. the home header logo until it docks)
        root.setAttribute('data-js', '')
        var theme = null
        var promo = null
        try {
          theme = localStorage.getItem('theme')
          promo = localStorage.getItem('attibling-promo-closed')
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        root.setAttribute('data-theme', theme)
        if (promo) root.setAttribute('data-promo-closed', '')
        {{#is "home"}}{{#if @custom.arrival_animation}}
        // First page of the home: the arrival animation (partials/home/intro.hbs, src/css/home/intro.css),
        // once per session, never with reduced motion; any click, key, wheel, touch or scroll ends it.
        // It removes itself after 2.1 s whatever happens (the CSS animation is over by then).
        try {
          if (!sessionStorage.getItem('attibling-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sessionStorage.setItem('attibling-intro', '1')
            root.setAttribute('data-intro', '{{#if @custom.use_geekly_logo}}play{{else}}sober{{/if}}')
            var events = ['pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll']
            var done = function () {
              root.removeAttribute('data-intro')
              for (var i = 0; i < events.length; i++) removeEventListener(events[i], skip, true)
            }
            var skip = function () {
              if (root.getAttribute('data-intro') == 'play') root.setAttribute('data-intro', 'skip')
              setTimeout(done, 160)
            }
            for (var i = 0; i < events.length; i++) addEventListener(events[i], skip, { capture: true, passive: true })
            setTimeout(done, 2100)
          }
        } catch (e) {}
        {{/if}}{{/is}}
        {{#is "post"}}{{#if @custom.reading_settings}}
        // Article pages, members: the display settings ("attibling-reading", src/js/reading-settings.js)
        // as data-reading-<name> on <html>, and the chosen fonts (fonts.bunny.net, as Ghost's own)
        try {
          var r = (root.hasAttribute('data-member') && JSON.parse(localStorage.getItem('attibling-reading'))) || {}
          var f = []
          var font = function (v, w) { if (typeof v == 'string' && v != 'default' && /^[a-z-]+$/.test(v)) f.push(v + w) }
          for (var k in r) {
            if (/^[a-z]+$/.test(k) && /^[a-z0-9-]+$/.test(r[k])) root.setAttribute('data-reading-' + k, r[k])
          }
          font(r.heading, ':400,700')
          font(r.body, ':400,400i,700')
          if (f.length) {
            var l = document.createElement('link')
            l.rel = 'stylesheet'
            l.href = 'https://fonts.bunny.net/css?family=' + f.join('|') + '&display=swap'
            l.setAttribute('data-reading-fonts', '')
            document.head.appendChild(l)
          }
        } catch (e) {}
        {{/if}}{{/is}}
        {{#is "page"}}{{#if @custom.reading_settings}}
        // Pages, members: only the link style of the display settings (src/css/article/links.css),
        // so a member who chose « Soulignés » on posts gets it in the pages too
        try {
          var pr = root.hasAttribute('data-member') && JSON.parse(localStorage.getItem('attibling-reading'))
          if (pr && pr.links == 'underline') root.setAttribute('data-reading-links', 'underline')
        } catch (e) {}
        {{/if}}{{/is}}
      })()
      // @license-end
    </script>

    {{!-- Fonts, served by the theme itself (no font service is contacted): Onest everywhere, Literata
    on posts only, both variable and split by script (partials/fonts.hbs, generated by
    src/fonts/build-fonts.py). Japanese, Korean and Chinese text uses the reader's system fonts.
    Ghost's custom fonts (Admin > Design) replace them through --gh-font-heading / --gh-font-body. --}}
    {{> fonts}}

    {{!-- Pacifico, the "ly" of the GEEKLY wordmark (use_geekly_logo), served by the theme (this
    @font-face is here so the URL works for a Ghost installed in a subdirectory); it is only
    downloaded when the wordmark is shown. The file holds only the letters l and y (3 KB instead of
    78 KB for the whole font; OFL-1.1, assets/fonts/pacifico/OFL.txt). --}}
    <style>
      @font-face {
        font-family: 'Pacifico';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: local('Pacifico-Regular'), url("{{asset 'fonts/pacifico/pacifico-ly.woff2'}}") format('woff2');
        unicode-range: U+006C, U+0079;
      }
    </style>

    <link rel="stylesheet" type="text/css" href="{{asset "css/app.css"}}" media="screen" />

    {{!-- This #block helper will inject a stylesheet for a specific page --}}
    {{{block "styles"}}}

    {{!-- This tag outputs SEO meta+structured data and other important settings --}}
    {{ghost_head}}

    {{!-- "Embed consent" setting (on by default), posts and pages: third-party embeds (YouTube, X,
    Vimeo… in the post HTML) load only when the reader asks. This policy, placed after {{ghost_head}}
    (Ghost's own scripts and the site's header code injection are already requested), forbids frames
    and scripts from other sites in the rest of the page, so the browser never contacts them, even
    without JavaScript; it keeps what Ghost needs (cdn.jsdelivr.net for Portal, search and comments;
    Stripe, hCaptcha and Turnstile, which Portal may load). The reader's choice loads the embed in the
    site's own page assets/html/embed.html, which has no such policy (src/js/embeds.js,
    partials/embed-consent.hbs). Until the script replaces them, the blocked frames are hidden; without
    JavaScript a sentence takes their place. Only when the owner turns on « Consent tools » (setting
    consent_tools, off by default) in the fallback consent mode, the common analytics / tag / ads services
    are added (partials/privacy/consent-hosts.hbs), for the scripts gated with data-consent. --}}
    {{#is "post, page"}}{{#if @custom.embed_consent}}
      <meta http-equiv="Content-Security-Policy" content="frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://*.hcaptcha.com https://challenges.cloudflare.com{{> "privacy/consent-hosts" kind="frame"}}; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net https://js.stripe.com https://*.hcaptcha.com https://challenges.cloudflare.com{{> "privacy/consent-hosts" kind="script"}}">
      <style>main iframe[src]:not([src^="/"], [src^="about:"], [src^="{{@site.url}}"], [data-embed-frame]) { visibility: hidden; }</style>
      <noscript><style>
        main iframe[src]:not([src^="/"], [src^="about:"], [src^="{{@site.url}}"]) { display: none !important; }
        main figure.kg-embed-card:has(> iframe[src]:not([src^="/"], [src^="about:"], [src^="{{@site.url}}"]))::before {
          content: "{{{t "This external content only loads when you ask for it: turn on JavaScript to show it."}}}";
          display: block; padding: 24px; border: 1px dashed; border-radius: 12px; font-family: system-ui, sans-serif; font-size: 15px; text-align: center; opacity: 0.8;
        }
      </style></noscript>
    {{/if}}{{/is}}

    {{!-- "Page transitions" setting: the browser animates from one page to the next (cross-document
    View Transitions, where supported, never with reduced motion); the named pairs and the timing
    are in src/css/components/transitions.css, the clicked tile is named by src/js/transitions.js. --}}
    {{#if @custom.page_transitions}}
      <style>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
    {{/if}}
  </head>
  <body class="{{body_class}}">
    {{!-- Skip link: first focusable element; every template gives its <main> id="main" --}}
    <a class="sr-only skip-link" href="#main">{{t "Skip to content"}}</a>

    {{!-- All the main content gets inserted here, index.hbs, post.hbs, etc --}}
    {{{body}}}

    {{!-- The footer --}}
    {{> footer}}

    {{!-- Third-party embeds on click: the facade and its strings (setting embed_consent) --}}
    {{#is "post, page"}}{{#if @custom.embed_consent}}{{> embed-consent}}{{/if}}{{/is}}

    {{!-- Fallback consent mode (setting consent_notice: Notice or Banner): the notice's template, shown
    only when a script gated with data-consent waits for an answer (src/js/privacy/); embeds ask in their
    own facade. None: never. The preferences panel is in the footer. --}}
    {{#match @custom.consent_notice "Notice"}}{{> "privacy/notice"}}{{/match}}
    {{#match @custom.consent_notice "Banner"}}{{> "privacy/notice"}}{{/match}}

    {{!-- Common scripts shared between pages. Every theme script is an async module (here and in the
    "scripts" blocks): a plain module waits in the deferred queue behind Ghost's own deferred scripts
    from {{ghost_head}} (Portal, search, comments: ~800 KB on a phone), async runs it as soon as it has
    arrived. They depend neither on each other's order nor on Ghost's scripts; each entry starts once the
    page is parsed (onReady, src/js/helpers.js). What must happen before the first paint stays in the
    inline scripts of <head> (theme mode, arrival animation, reading settings) and of the « Tags » grid. --}}
    <script type="module" async src="{{asset "js/app.js"}}"></script>

    {{!-- The #block helper will pull in data from the #contentFor other template files --}}
    {{{block "scripts"}}}

    {{!-- Ghost outputs important scripts and data with this tag --}}
    {{ghost_foot}}
  </body>
</html>
