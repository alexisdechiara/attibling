<!DOCTYPE html>
{{!-- data-member: a signed-in member (members-only features in the scripts, src/js/store.js) --}}
<html lang="{{@site.locale}}"{{#if @member}} data-member{{/if}}>
  <head>
    {{!-- Document Settings --}}
    <meta charset="utf-8" />

    {{!-- Base Meta --}}
    <title>{{meta_title}}</title>
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark">

    {{!-- Preload assets --}}
    <link rel="preload" href="{{asset "css/app.css"}}" as="style" />
    <link rel="modulepreload" href="{{asset "js/app.js"}}" />

    {{!-- This #block helper will try to preload page-specific assets --}}
    {{{block "preload"}}}

    {{!-- Before the first paint: the theme mode (data-theme light | dark, from localStorage "theme",
    "auto" or nothing following the system), and the home subscription block closed for good
    (data-promo-closed, localStorage "attibling-promo-closed"). --}}
    <script>
      // @license magnet:?xt=urn:btih:d3d9a9a6595521f9666a5e94cc830dab83b65699&dn=expat.txt Expat
      (function () {
        var root = document.documentElement
        var theme = null
        var promo = null
        try {
          theme = localStorage.getItem('theme')
          promo = localStorage.getItem('attibling-promo-closed')
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        root.setAttribute('data-theme', theme)
        if (promo) root.setAttribute('data-promo-closed', '')
      })()
      // @license-end
    </script>

    {{!-- Fonts (Google Fonts, display=swap), only the styles the CSS selects: Onest 400 to 800 for the
    interface and the headings; Literata (article text, roman 400 to 650 and italic 400) only on posts
    and pages. Noto Sans JP / KR / TC follow Onest for Japanese, Korean and Chinese sites.
    Ghost's custom fonts (Admin > Design) replace them through --gh-font-heading / --gh-font-body. --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {{#is "post, page"}}
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..650;1,7..72,400&amp;family=Onest:wght@400..800&amp;display=swap">
    {{else}}
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400..800&amp;display=swap">
    {{/is}}
    {{#match @site.locale "~^" "ja"}}
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400..800&amp;display=swap">
    {{/match}}
    {{#match @site.locale "~^" "ko"}}
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400..800&amp;display=swap">
    {{/match}}
    {{#match @site.locale "~^" "zh"}}
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400..800&amp;display=swap">
    {{/match}}

    {{!-- Pacifico, the "ly" of the GEEKLY wordmark (use_geekly_logo), served by the theme (this
    @font-face is here so the URL works for a Ghost installed in a subdirectory); it is only
    downloaded when the wordmark is shown. --}}
    <style>
      @font-face {
        font-family: 'Pacifico';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: local('Pacifico-Regular'), url("{{asset 'fonts/pacifico/pacifico.woff2'}}") format('woff2');
      }
    </style>

    <link rel="stylesheet" type="text/css" href="{{asset "css/app.css"}}" media="screen" />

    {{!-- This #block helper will inject a stylesheet for a specific page --}}
    {{{block "styles"}}}

    {{!-- This tag outputs SEO meta+structured data and other important settings --}}
    {{ghost_head}}

    {{!-- "Disable fade animation" setting: no entrance animations (data-animate, legacy pages) --}}
    {{#if @custom.disable_fade_animation}}
      <style>:root { --show-fade-animation: 0; }</style>
    {{/if}}
  </head>
  <body class="{{body_class}}">
    {{!-- Skip link: first focusable element; every template gives its <main> id="main" --}}
    <a class="sr-only skip-link" href="#main">{{t "Skip to content"}}</a>

    {{!-- All the main content gets inserted here, index.hbs, post.hbs, etc --}}
    {{{body}}}

    {{!-- The footer --}}
    {{> footer}}

    {{!-- Common scripts shared between pages --}}
    <script type="module" src="{{asset "js/app.js"}}"></script>

    {{!-- The #block helper will pull in data from the #contentFor other template files --}}
    {{{block "scripts"}}}

    {{!-- Ghost outputs important scripts and data with this tag --}}
    {{ghost_foot}}
  </body>
</html>
