{{!--
Rows of the archives list, one <li> per post of the current {{#get}} result (see pages/archives.hbs).
data-* attributes feed the filters of archives.js: year, month, tag slugs (public AND internal: a series
#serie-x is "hash-serie-x"), primary tag slug. Without JavaScript each row reads « 25 nov. 2025 — Title —
Tag • 5 min ».
--}}
{{#foreach posts}}
  <li class="archive-item" data-archive-item data-year="{{date published_at format="YYYY"}}" data-month="{{date published_at format="MM"}}" data-month-name="{{date published_at format="MMMM"}}" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}" data-primary="{{primary_tag.slug}}" data-date="{{date published_at format="YYYY-MM-DD"}}">
    <time class="archive-item__date" datetime="{{date published_at format="YYYY-MM-DD"}}"><span class="archive-item__day">{{date published_at format="D"}}</span> <span class="archive-item__month-year">{{date published_at format="MMM YYYY"}}</span></time>
    <a class="archive-item__title" href="{{url}}">{{title}}</a>
    <span class="meta archive-item__meta">{{#if primary_tag}}<span>{{primary_tag.name}}</span><span class="meta__dot" aria-hidden="true">•</span>{{/if}}<span>{{reading_time minute=(t "1 min") minutes=(t "% min")}}</span></span>
  </li>
{{/foreach}}
