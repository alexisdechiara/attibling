{{!--
« Tout ce que le site peut garder dans votre navigateur »: one row per key of src/js/privacy/registry.js,
in the same order (src/tests/privacy.test.js fails when a key is missing here, or here only). Rendered by
the theme on the « Cookies et confidentialité » page (privacy/page.hbs), so it is always true for the
theme in use, and read by src/js/privacy/controls.js for the purpose of each key it finds in the browser.
Columns: name, set by, for whom, purpose, how long. Ready to read as stacked rows on phones.
--}}
<div class="table-scroll table-scroll--stack privacy-table">
  <table role="table">
    <thead role="rowgroup">
      <tr role="row"><th role="columnheader" scope="col">{{t "Name"}}</th><th role="columnheader" scope="col">{{t "Set by"}}</th><th role="columnheader" scope="col">{{t "For"}}</th><th role="columnheader" scope="col">{{t "Purpose"}}</th><th role="columnheader" scope="col">{{t "How long"}}</th></tr>
    </thead>
    <tbody role="rowgroup">
      <tr role="row" data-storage-key="theme"><td role="cell"><code>theme</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "The light, dark or automatic mode chosen with the header button"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until changed or cleared"}}</td></tr>
      <tr role="row" data-storage-key="attibling-promo-closed"><td role="cell"><code>attibling-promo-closed</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "visitors"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "The home page's subscription block, closed for good"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until cleared"}}</td></tr>
      <tr role="row" data-storage-key="attibling-intro"><td role="cell"><code>attibling-intro</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "The home page's arrival animation, already played during this visit"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until the tab is closed"}}</td></tr>
      <tr role="row" data-storage-key="attibling-hero-cue"><td role="cell"><code>attibling-hero-cue</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "The small hint of the home page's banner dots, already shown during this visit"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until the tab is closed"}}</td></tr>
      <tr role="row" data-storage-key="attibling-embeds"><td role="cell"><code>attibling-embeds</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "The services (YouTube, X…) you set one by one: shown without a click, or kept behind their frame"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until you take it back or clear it"}}</td></tr>
      <tr role="row" data-storage-key="attibling-privacy"><td role="cell"><code>attibling-privacy</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "members"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "You turned off “Continue reading”: nothing is recorded"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until you take it back or clear it"}}</td></tr>
      <tr role="row" data-storage-key="attibling-consent"><td role="cell"><code>attibling-consent</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "Your answer about the optional services (accepted or refused, per kind) and its date"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "6 months, then asked again"}}</td></tr>
      <tr role="row" data-storage-key="plausible_ignore"><td role="cell"><code>plausible_ignore</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme, for Plausible"}}</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "You asked not to be counted in the visit statistics"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until you take it back or clear it"}}</td></tr>
      <tr role="row" data-storage-key="attibling-reading"><td role="cell"><code>attibling-reading</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "members"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "Your display settings for posts (theme, fonts, size, width…)"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until “Reset” or cleared"}}</td></tr>
      <tr role="row" data-storage-key="attibling-saved"><td role="cell"><code>attibling-saved</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "members"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "Your “Read later” list (address, title, image, section and reading time of each post; 100 at most)"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until you remove the posts or clear it"}}</td></tr>
      <tr role="row" data-storage-key="attibling-progress"><td role="cell"><code>attibling-progress</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "members"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "“Continue reading”: where you stopped in the last 6 posts you started (can be turned off)"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until the post is read, “Remove” or cleared"}}</td></tr>
      <tr role="row" data-storage-key="attibling-probe"><td role="cell"><code>attibling-probe</code></td><td role="cell" data-label="{{t "Set by"}}">{{t "the theme"}}</td><td role="cell" data-label="{{t "For"}}">{{t "members"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "A check that the browser's storage works: written and removed at once"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "None"}}</td></tr>
      <tr role="row" data-storage-key="ghost-history"><td role="cell"><code>ghost-history</code></td><td role="cell" data-label="{{t "Set by"}}">Ghost</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "Only when the site records where its members come from: the last pages viewed (15 at most, 24 hours) and the referring site, sent to Ghost if you subscribe"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until the tab is closed"}}</td></tr>
      <tr role="row" data-storage-key="ghost-portal-gift-form-state"><td role="cell"><code>ghost-portal-gift-form-state</code></td><td role="cell" data-label="{{t "Set by"}}">Ghost</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "Only while you fill in a gift subscription: the form's state"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until the tab is closed"}}</td></tr>
      <tr role="row" data-storage-key="ghost-recommendations-clicked"><td role="cell"><code>ghost-recommendations-clicked</code></td><td role="cell" data-label="{{t "Set by"}}">Ghost</td><td role="cell" data-label="{{t "For"}}">{{t "everyone"}}</td><td role="cell" data-label="{{t "Purpose"}}" data-storage-purpose>{{t "Only when the site shows recommendations: those you already opened, so they are counted once"}}</td><td role="cell" data-label="{{t "How long"}}">{{t "Until cleared"}}</td></tr>
    </tbody>
  </table>
</div>
