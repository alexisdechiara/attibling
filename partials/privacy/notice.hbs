{{!--
Fallback consent notice (theme setting consent_notice = Notice or Banner; default.hbs renders this only
then). Inert in a <template>: src/js/privacy/notice.js shows it only when the page holds a script the
owner gated with data-consent and the reader has not answered yet (nor sent Global Privacy Control / Do
Not Track). Not modal, it takes no focus and covers nothing essential: « Banner », a bar across the
bottom shown on arrival; « Notice », a small card in the bottom corner shown after a little scrolling
or 12 seconds. « Tout refuser » and « Tout accepter » have the same size and look; « Personnaliser »
opens the preferences panel; the close button refuses (it says so). {categories} is filled in by the
script with the kinds of services on the page.
--}}
<template id="consent-notice">
  <section class="consent-notice" aria-labelledby="consent-notice-title" data-consent-notice
    data-analytics="{{t "audience measurement"}}" data-embeds="{{t "embedded content"}}" data-other="{{t "other services"}}">
    <div class="consent-notice__text">
      <h2 class="consent-notice__title" id="consent-notice-title">{{t "Your agreement, if you wish"}}</h2>
      <p class="consent-notice__body" data-consent-body data-template="{{t "With your agreement, this site also uses services that may set cookies or follow your visit: {categories}. Without it, they stay off. You can change your mind at any time from “Cookies and privacy” at the bottom of the page." categories="{categories}"}}"></p>
    </div>
    <div class="consent-notice__actions">
      <button type="button" class="button button--s consent-notice__choice" data-consent-answer="false">{{t "Refuse all"}}</button>
      <button type="button" class="button button--s consent-notice__choice" data-consent-answer="true">{{t "Accept all"}}</button>
      <button type="button" class="consent-notice__customise" data-consent-customise>{{t "Customise"}}</button>
    </div>
    <button type="button" class="icon-button consent-notice__close" data-consent-answer="false" aria-label="{{t "Close and continue without accepting"}}" title="{{t "Close and continue without accepting"}}">{{> "icons/close"}}</button>
  </section>
</template>
