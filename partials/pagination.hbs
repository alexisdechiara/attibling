{{!--
Pagination: Ghost's {{pagination}} helper renders this partial with page, pages, prev and next.
« Plus récents » / « Plus anciens » pill links around « Page N sur M »; nothing when there is one page.
--}}
{{#match pages ">" 1}}
  <nav class="pagination container" aria-label="{{t "Pagination"}}">
    {{#if prev}}
      <a class="button button--ghost pagination__link" href="{{page_url prev}}" rel="prev">{{> "icons/arrow-left" class="icon-flip-rtl"}}<span>{{t "Newer posts"}}</span></a>
    {{/if}}
    <span class="pagination__status">{{t "Page"}} {{page}} {{t "of"}} {{pages}}</span>
    {{#if next}}
      <a class="button button--ghost pagination__link" href="{{page_url next}}" rel="next"><span>{{t "Older posts"}}</span>{{> "icons/arrow-right" class="icon-flip-rtl"}}</a>
    {{/if}}
  </nav>
{{/match}}
