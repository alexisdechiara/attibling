{{!-- The attributes written by image/srcset.hbs (its only caller; parameters documented there), with
imageFormat = "webp", or false for the image's own format. --}}
{{~#match widths "large"}} srcset="{{img_url image size="m" format=imageFormat}} 600w, {{img_url image size="w800" format=imageFormat}} 800w, {{img_url image size="l" format=imageFormat}} 1000w, {{img_url image size="w1400" format=imageFormat}} 1400w, {{img_url image size="xl" format=imageFormat}} 2000w"
{{~else match widths "medium"}} srcset="{{img_url image size="s" format=imageFormat}} 300w, {{img_url image size="w400" format=imageFormat}} 400w, {{img_url image size="w500" format=imageFormat}} 500w, {{img_url image size="m" format=imageFormat}} 600w, {{img_url image size="w800" format=imageFormat}} 800w, {{img_url image size="l" format=imageFormat}} 1000w, {{img_url image size="w1400" format=imageFormat}} 1400w"
{{~else}} srcset="{{img_url image size="w220" format=imageFormat}} 220w, {{img_url image size="s" format=imageFormat}} 300w, {{img_url image size="w400" format=imageFormat}} 400w, {{img_url image size="w500" format=imageFormat}} 500w, {{img_url image size="m" format=imageFormat}} 600w, {{img_url image size="w800" format=imageFormat}} 800w, {{img_url image size="l" format=imageFormat}} 1000w"{{/match}} src="{{img_url image size=srcSize format=imageFormat}}"
