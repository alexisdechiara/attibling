{{!--
« Se connecter » link: to the sign-in form of the theme's subscription page (#connexion), found as
subscribe-href.hbs says; Ghost's Portal sign-in only when the site has no such page.
Shown when members are enabled (invite-only sites too); render it inside {{#unless @member}}.
Parameters:
  class="..."   classes of the link (none by default)
  label="..."   link text (default the translation of "Login")
--}}
{{#if @site.members_enabled}}
  <a{{#if class}} class="{{class}}"{{/if}} {{> subscribe-href signin=true}}>{{#if label}}{{label}}{{else}}{{t "Login"}}{{/if}}</a>
{{/if}}
