{{!--
Links of an author (Ghost Admin > Settings > Staff > the profile): website and social accounts, as
44px round icon buttons with an accessible name. Nothing at all when the profile has none.
Inside an author context. Each link is guarded by {{#if <field>}}: social_url would otherwise fall back
to the site's own account.
Parameters:
  linksClass="..."   extra classes on the list
--}}
{{#has any="website, twitter, facebook, linkedin, bluesky, threads, mastodon, tiktok, youtube, instagram"}}
  <ul class="author-links{{#if linksClass}} {{linksClass}}{{/if}}" role="list">
    {{#if website}}<li><a class="icon-button author-links__link" href="{{website}}" target="_blank" rel="noopener" aria-label="{{t "Website"}}">{{> "icons/link"}}</a></li>{{/if}}
    {{#if twitter}}<li><a class="icon-button author-links__link" href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">{{> "icons/x"}}</a></li>{{/if}}
    {{#if facebook}}<li><a class="icon-button author-links__link" href="{{social_url type="facebook"}}" target="_blank" rel="noopener" aria-label="Facebook">{{> "icons/facebook"}}</a></li>{{/if}}
    {{#if linkedin}}<li><a class="icon-button author-links__link" href="{{social_url type="linkedin"}}" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a></li>{{/if}}
    {{#if bluesky}}<li><a class="icon-button author-links__link" href="{{social_url type="bluesky"}}" target="_blank" rel="noopener" aria-label="Bluesky">{{> "icons/bluesky"}}</a></li>{{/if}}
    {{#if threads}}<li><a class="icon-button author-links__link" href="{{social_url type="threads"}}" target="_blank" rel="noopener" aria-label="Threads">{{> "icons/threads"}}</a></li>{{/if}}
    {{#if mastodon}}<li><a class="icon-button author-links__link" href="{{social_url type="mastodon"}}" target="_blank" rel="noopener" aria-label="Mastodon">{{> "icons/mastodon"}}</a></li>{{/if}}
    {{#if tiktok}}<li><a class="icon-button author-links__link" href="{{social_url type="tiktok"}}" target="_blank" rel="noopener" aria-label="TikTok">{{> "icons/tiktok"}}</a></li>{{/if}}
    {{#if youtube}}<li><a class="icon-button author-links__link" href="{{social_url type="youtube"}}" target="_blank" rel="noopener" aria-label="YouTube">{{> "icons/youtube"}}</a></li>{{/if}}
    {{#if instagram}}<li><a class="icon-button author-links__link" href="{{social_url type="instagram"}}" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a></li>{{/if}}
  </ul>
{{/has}}
