{{!--
Body of the subscription page (page-newsletter.hbs for the slug "newsletter", custom-subscribe.hbs for any
other slug; point the « Subscribe page URL » setting at it). Inside the page's template context.

Visitors:
  1. Opening section, straight in the page (dark band, no card), at least the first screen tall
     (min-height: 100svh minus the header): title « S'abonner à <site> », lead sentence = the page's
     excerpt, else the theme's sentence; Ghost's native form (data-members-form="subscribe": Ghost adds the
     classes loading / success / error and writes the error in [data-members-error]); the page's content
     (the Ghost editor: a consent / legal line, e.g. « En vous inscrivant, vous acceptez les mentions
     légales ») under the form; « Se connecter » (Portal). Beside it: what a subscription brings — the
     newsletter, then the theme's reading tools (members only on every site using the theme), then the
     comments when they are open to all members.
  2. Questions (<details>): true for any Ghost site (free sign-up, no password, unsubscribing).
  3. Closing call to action: back to the form (one form on the page).
Members: « Vous êtes abonné », their address, Account (Portal), back home, sign out, their tools.
--}}
{{#contentFor "preload"}}
  <link rel="preload" href="{{asset "css/newsletter.css"}}" as="style" />
{{/contentFor}}
{{#contentFor "styles"}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/newsletter.css"}}" media="screen" />
{{/contentFor}}
{{#contentFor "scripts"}}
  <script type="module" src="{{asset "js/newsletter.js"}}"></script>
{{/contentFor}}

{{> header}}

<main id="main" class="site-main subscribe{{#if @member}} subscribe--member{{/if}}">
  {{#if @member}}
    <section class="container subscribe-member" aria-labelledby="subscribe-member-title">
      <p class="subscribe-member__status">{{> "icons/check-circle"}}{{t "Subscribed!"}}</p>
      <h1 class="subscribe-member__title" id="subscribe-member-title">{{t "You're subscribed to {blogtitle}" blogtitle=@site.title}}</h1>
      <p class="subscribe-member__text">{{t "Signed in as"}} <strong>{{@member.email}}</strong>. {{t "Manage your emails and your profile from your account."}}</p>
      <div class="subscribe-member__actions">
        <a class="button button--primary button--l" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
        <a class="button button--l" href="{{@site.url}}">{{t "Back to home"}}</a>
        <a class="subscribe-member__signout" href="javascript:" data-members-signout>{{t "Sign out"}}</a>
      </div>

      <h2 class="subscribe-member__heading">{{t "Your member tools"}}</h2>
      <ul class="subscribe-tools" role="list">
        <li class="subscribe-tools__item">
          <span class="subscribe-tools__icon" aria-hidden="true">{{> "icons/bookmark"}}</span>
          <span class="subscribe-tools__text"><b>{{t "“Read later”"}}</b>{{t "Save posts to come back to them whenever you like."}}</span>
          <a class="button button--s subscribe-tools__action" href="{{@site.url}}/favoris/">{{t "See my list"}}</a>
        </li>
        <li class="subscribe-tools__item">
          <span class="subscribe-tools__icon" aria-hidden="true">{{> "icons/clock"}}</span>
          <span class="subscribe-tools__text"><b>{{t "Continue reading"}}</b>{{t "Pick a post up where you left it."}}</span>
        </li>
        <li class="subscribe-tools__item">
          <span class="subscribe-tools__icon" aria-hidden="true">{{> "icons/sliders"}}</span>
          <span class="subscribe-tools__text"><b>{{t "Reading settings"}}</b>{{t "Font, spacing, alignment: read your way."}}</span>
        </li>
        {{#match @site.comments_access "all"}}
          <li class="subscribe-tools__item">
            <span class="subscribe-tools__icon" aria-hidden="true">{{> "icons/comment"}}</span>
            <span class="subscribe-tools__text"><b>{{t "Comment on posts"}}</b>{{t "Share your opinion under every post."}}</span>
          </li>
        {{/match}}
      </ul>
    </section>
  {{else}}
    <section class="subscribe-hero" aria-labelledby="subscribe-title">
      <div class="container subscribe-hero__inner">
        <div class="subscribe-hero__main">
          <h1 class="subscribe-hero__title" id="subscribe-title">{{t "Subscribe to {blogtitle}" blogtitle=@site.title}}</h1>
          {{#post}}
            <p class="subscribe-hero__lead">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "It's free: get the latest posts straight to your inbox and enjoy the reading tools reserved for members."}}{{/if}}</p>
          {{/post}}

          {{#if @site.members_enabled}}
            {{#unless @site.members_invite_only}}
              <form class="subscribe-form" id="subscribe-form" data-members-form="subscribe" data-subscribe-form>
                <label class="subscribe-form__label" for="subscribe-email">{{t "Your email address"}}</label>
                <div class="subscribe-form__fields">
                  <input class="subscribe-form__input" id="subscribe-email" type="email" name="email" autocomplete="email" required data-members-email>
                  <button class="button button--light button--l subscribe-form__button" type="submit"><span class="subscribe-form__spinner" aria-hidden="true"></span><span>{{t "Subscribe"}}</span></button>
                </div>
                <div class="subscribe-form__success" tabindex="-1" data-subscribe-success>
                  {{> "icons/check-circle"}}
                  <p><b>{{t "Great! You've successfully signed up."}}</b> {{t "Now check your inbox and click the link to confirm your subscription."}}</p>
                </div>
                <p class="subscribe-form__error" role="alert"><span data-members-error></span><span class="subscribe-form__error-default">{{t "Please enter a valid email address"}}</span></p>
                <p class="subscribe-form__hint">{{t "No payment · one-click unsubscribe from every email"}}</p>
              </form>
            {{/unless}}
          {{/if}}
          {{#post}}
            {{#if html}}<div class="subscribe-hero__notes">{{content}}</div>{{/if}}
          {{/post}}
          <p class="subscribe-hero__signin">{{t "Already a member?"}} <a href="#/portal/signin" data-portal="signin">{{t "Login"}}</a></p>
        </div>

        <div class="subscribe-hero__benefits">
          <div class="subscribe-benefit">
            <span class="subscribe-benefit__icon" aria-hidden="true">{{> "icons/mail"}}</span>
            <div>
              <h2 class="subscribe-benefit__title">{{t "New posts by email"}}</h2>
              <p class="subscribe-benefit__text">{{t "The newsletter: every new post lands in your inbox."}}</p>
            </div>
          </div>
          <h2 class="subscribe-hero__tools-title">{{t "And on the site, reading tools"}}</h2>
          <ul class="subscribe-hero__tools" role="list">
            <li>{{> "icons/summary"}}<span><b>{{t "“In short”"}}</b> {{t "A summary at the top of long posts."}}</span></li>
            <li>{{> "icons/bookmark"}}<span><b>{{t "“Read later”"}}</b> {{t "Save posts to come back to them whenever you like."}}</span></li>
            <li>{{> "icons/clock"}}<span><b>{{t "Continue reading"}}</b> {{t "Pick a post up where you left it."}}</span></li>
            <li>{{> "icons/sliders"}}<span><b>{{t "Reading settings"}}</b> {{t "Font, spacing, alignment: read your way."}}</span></li>
          </ul>
          {{#match @site.comments_access "all"}}
            <p class="subscribe-hero__comments">{{> "icons/comment"}}<span><b>{{t "Comment on posts"}}</b> {{t "Share your opinion under every post."}}</span></p>
          {{/match}}
        </div>
      </div>
    </section>

    <section class="container subscribe-faq" aria-labelledby="subscribe-faq-title">
      <h2 class="subscribe-faq__title" id="subscribe-faq-title">{{t "Frequently asked questions"}}</h2>
      <div class="subscribe-faq__list">
        <details class="subscribe-faq__item">
          <summary>{{t "Is it really free?"}}{{> "icons/chevron-down"}}</summary>
          <p>{{t "Yes. No means of payment is asked for."}}</p>
        </details>
        <details class="subscribe-faq__item">
          <summary>{{t "Do I need a password?"}}{{> "icons/chevron-down"}}</summary>
          <p>{{t "No. To sign in, you get a link by email: one click and you are in."}}</p>
        </details>
        <details class="subscribe-faq__item">
          <summary>{{t "How do I unsubscribe?"}}{{> "icons/chevron-down"}}</summary>
          <p>{{t "Every email ends with an unsubscribe link. You can also manage your emails from your account at any time."}}</p>
        </details>
      </div>
    </section>

    {{#if @site.members_enabled}}
      {{#unless @site.members_invite_only}}
        <section class="container subscribe-cta" aria-labelledby="subscribe-cta-title">
          <h2 class="subscribe-cta__title" id="subscribe-cta-title">{{t "Ready to subscribe?"}}</h2>
          <p class="subscribe-cta__text">{{t "No payment, and you can unsubscribe at any time."}}</p>
          <a class="button button--primary button--l" href="#subscribe-email" data-subscribe-jump>{{t "Subscribe"}}{{> "icons/arrow-up"}}</a>
        </section>
      {{/unless}}
    {{/if}}
  {{/if}}
</main>
