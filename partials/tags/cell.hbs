{{!--
A cell of the « Tags » grid (partials/pages/tags.hbs), in a tag context fetched with include="count.posts":
one link to the tag (its picture under a scrim, or a tinted surface with the number of posts drawn large;
name, number of posts, description when the tag has one) and a « Détails » button (shown by
src/js/tags.js) that opens the preview with the tag's latest posts.
data-posts / data-image feed the arrangement (src/js/tags/layout.js), data-description the preview.
Parameters:
  size="feature" | "wide"   size without JavaScript (the server's default arrangement)
--}}
<li class="tag-cell{{#if feature_image}} tag-cell--image{{else}} tag-cell--no-image{{/if}}{{#if size}} tag-cell--{{size}}{{/if}}" data-tag="{{slug}}" data-posts="{{count.posts}}"{{#if feature_image}} data-image{{/if}}>
  <a class="tag-cell__link" href="{{url}}">
    {{#if feature_image}}
      <img class="tag-cell__image" src="{{img_url feature_image size="m"}}" srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w" sizes="auto, (min-width: 64rem) 220px, (min-width: 40rem) 25vw, 50vw" alt="" loading="lazy" decoding="async">
    {{else}}
      <span class="tag-cell__numeral" aria-hidden="true">{{count.posts}}</span>
    {{/if}}
    <span class="tag-cell__text">
      <span class="tag-cell__name">{{name}}</span>
      <span class="tag-cell__count">{{plural count.posts empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</span>
      {{#if description}}<span class="tag-cell__description">{{description}}</span>{{/if}}
    </span>
  </a>
  <button type="button" class="tag-cell__details" aria-expanded="false" aria-label="{{t "Details: {name}" name=name}}" data-tag-details hidden>{{> "icons/info"}}</button>
</li>
