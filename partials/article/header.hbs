{{!--
Article header (post context): the feature image with the title over it on a dark card (style
« Carte ») or across the page (« Immersif »), the primary tag as a pill and the second public tag,
the author, the date and reading time, « Mis à jour le » when the post carries the internal tag
#mis-a-jour, and the members' « À lire plus tard » button. Without a feature image, or when a member
hides the cover image (display settings), the title sits on the plain page surface.

soloAuthor=true (post.hbs, single-author site): the author's name and photo are not links.

Stable hooks (page transitions): [data-article-image] (the picture), [data-article-title] (the h1).
--}}
<header class="article-header{{#unless feature_image}} article-header--no-image{{/unless}}">
  <div class="article-header__card">
    {{#if feature_image}}
      <div class="article-header__media">
        <img class="article-header__image" data-article-image
          srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
          sizes="(max-width: 767px) 100vw, 76vw"
          src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}" fetchpriority="high" decoding="async">
      </div>
    {{/if}}

    <div class="article-header__content">
      {{#if primary_tag}}
        <div class="article-header__tags">
          <a class="article-header__tag pill" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
          {{#foreach tags from="2" limit="1"}}<a class="article-header__tag-link" href="{{url}}">{{name}}</a>{{/foreach}}
        </div>
      {{/if}}

      <h1 class="article-header__title" data-article-title>{{title}}</h1>

      <div class="article-header__meta">
        {{#if soloAuthor}}<span class="article-header__avatar" aria-hidden="true">{{else}}<a class="article-header__avatar" href="{{primary_author.url}}" tabindex="-1" aria-hidden="true">{{/if}}
          {{#if primary_author.profile_image}}
            <img src="{{img_url primary_author.profile_image size="xs"}}" alt="" width="40" height="40" loading="lazy" decoding="async">
          {{else}}
            <span>{{> "icons/user"}}</span>
          {{/if}}
        {{#if soloAuthor}}</span>{{else}}</a>{{/if}}
        <div class="article-header__byline">
          <span class="article-header__authors">{{#if soloAuthor}}{{authors separator=", " autolink="false"}}{{else}}{{authors separator=", "}}{{/if}}</span>
          <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="LL"}}</time> • {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
          {{#has tag="#mis-a-jour"}}
            <span class="article-header__updated">{{t "Updated on"}} <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at format="LL"}}</time></span>
          {{/has}}
        </div>
        {{> bookmark-button labelled=true bookmarkClass="article-header__bookmark"}}
      </div>
    </div>
  </div>
  {{#if feature_image_caption}}
    <p class="article-header__caption container">{{feature_image_caption}}</p>
  {{/if}}
</header>
