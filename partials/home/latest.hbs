{{!--
« Derniers articles »: the latest post as a large lead card (« Nouveau » pill, tag, title, excerpt,
date • reading time) and the six next posts as compact rows beside it, the stack exactly as tall as the
lead (phones: the lead, then the list). Uses the 7 posts of the home page (posts_per_page = 7);
« Tout voir » leads to /page/2/ when there are more.
--}}
<section class="home-section latest container" aria-labelledby="latest-title">
  {{#if pagination.next}}
    {{> section-header title=(t "Latest posts") id="latest-title" url=(page_url pagination.next) divider=true}}
  {{else}}
    {{> section-header title=(t "Latest posts") id="latest-title" divider=true}}
  {{/if}}
  {{#if posts}}
  <div class="latest__grid">
    {{#foreach posts limit="1"}}
      <article class="lead{{> "vignette/missing" noImage=" lead--no-image"}}" data-post-tile>
        <a class="lead__link" href="{{url}}">
          <span class="lead__media">
            {{> "vignette/image" imgClass="lead__image" widths="m-l-xl" srcSize="l" sizes="(max-width: 767px) 100vw, 860px" priority="auto" placeholder="tile"}}
          </span>
          <h3 class="lead__title">{{title}}</h3>
          <span class="lead__kicker"><span class="pill">{{t "New"}}</span>{{#if primary_tag}}<span class="lead__tag">{{primary_tag.name}}</span>{{/if}}</span>
          <span class="lead__excerpt">{{excerpt words="40"}}</span>
          {{> tile-meta meta="date-time"}}
        </a>
        {{> bookmark-button}}
      </article>
    {{/foreach}}
    {{#if posts.[1]}}
      <ol class="latest__list" role="list" aria-label="{{t "Other recent posts"}}">
        {{#foreach posts from="2" to="7"}}
          <li>{{> row-item}}</li>
        {{/foreach}}
      </ol>
    {{/if}}
  </div>
  {{else}}
  <p class="latest__empty">{{t "No posts"}}</p>
  {{/if}}
</section>
