{{!-- Home row « posters »: the tag's latest 10 posts as 2:3 posters in a row that scrolls sideways, ending with a link to the tag page. Tag context (rows.hbs). --}}
{{#get "posts" filter=(concat "tag:" slug) include="tags" limit="10" as |rowposts|}}
  <section class="home-section row row--posters" aria-labelledby="row-{{../slug}}">
    <div class="container">
      {{> section-header title=../name titleUrl=../url id=(concat "row-" ../slug) note=(plural ../count.posts empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")) url=../url}}
    </div>
    <div class="shelf" data-shelf>
      <ol class="shelf__track js-slider-track" role="list">
        {{#foreach rowposts}}<li class="shelf__item">{{> poster-tile}}</li>{{/foreach}}
        <li class="shelf__item"><a class="poster-more" href="{{../url}}">{{t "All posts"}}<span class="sr-only"> ({{../name}})</span></a></li>
      </ol>
      {{> shelf-controls label=../name}}
    </div>
  </section>
{{/get}}
