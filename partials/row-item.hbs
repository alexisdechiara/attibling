{{!--
Compact row item: a small 16:9 thumbnail, the title on two lines at most and the meta line; the whole
row is one link. Used for the stack next to the lead card of « Derniers articles ». Use inside a post
context, in a list item.
Parameters:
  meta="tag-date" (default) | "tag-time" | "time" | "date-time" | "none"   (see tile-meta.hbs)
--}}
<a class="row-item" href="{{url}}">
  <span class="row-item__media">
    {{#if feature_image}}
      <img src="{{img_url feature_image size="s"}}" srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w" sizes="152px" alt="" loading="lazy" decoding="async">
    {{else}}
      <span class="row-item__placeholder" aria-hidden="true"></span>
    {{/if}}
  </span>
  <span class="row-item__text">
    <span class="row-item__title">{{title}}</span>
    {{#if meta}}{{> tile-meta}}{{else}}{{> tile-meta meta="tag-date"}}{{/if}}
  </span>
</a>
