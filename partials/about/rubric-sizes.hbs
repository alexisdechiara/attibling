{{!-- The sizes attribute of a rubric's picture (about/rubric.hbs, in its foreach): the width of the cell's box in the
grid of src/css/about.css, which depends on the cell's position. One column below 40rem, two to 64rem (the first
cell spans both), four after: the first cell is 2 × 2, the second 2 × 1, the third and the fourth 1 × 1 (the third
spans two when it is the last), the following ones fill rows of four, except the last row, whose cells widen
to fill it (1, 2 or 4 columns: half a row stands for them). --}}
{{~#has number="1"~}}
  (max-width: 1023px) 92vw, (max-width: 1443px) calc((92vw - 16px) / 2), 656px
{{~else~}}
  {{~#has number="3"~}}
    {{~#if @last~}}
      (max-width: 639px) 92vw, (max-width: 1443px) calc((92vw - 16px) / 2), 656px
    {{~else~}}
      (max-width: 639px) 92vw, (max-width: 1023px) calc((92vw - 16px) / 2), (max-width: 1443px) calc((92vw - 48px) / 4), 320px
    {{~/if~}}
  {{~else~}}
    {{~#has number="4"~}}
      (max-width: 639px) 92vw, (max-width: 1023px) calc((92vw - 16px) / 2), (max-width: 1443px) calc((92vw - 48px) / 4), 320px
    {{~else~}}
      (max-width: 639px) 92vw, (max-width: 1443px) calc((92vw - 16px) / 2), 656px
    {{~/has~}}
  {{~/has~}}
{{~/has~}}
