{{!--
Article page. Style « Carte » (rounded header card, reading column, table of contents in the margin) or
« Immersif » (full-bleed header, text across the page): the style comes from the theme setting
article_style, the internal tags #immersif / #carte of the post, and the member's own choice in the
display settings (data-reading-style on <html>, applied before the first paint by default.hbs).

Order of the article: header card, series box and « En bref » (the author's numbered points, an HTML
card <ol class="en-bref">, moved here by post.js; visitors see a teaser), the content, then the
« Publié le · Mis à jour le » line (#mis-a-jour), the series « Précédent / Suivant » line (always the last
element of the content), tags and share, the author box, the comments, « Recommandé pour vous ».
See docs/guide-auteur.md (« Articles ») for every convention.

data-* of [data-article] describe the post for the reading progress kept by members (src/js/store.js)
and carry the strings the scripts need (copy buttons, series).
--}}

{{#contentFor "preload"}}
  <link rel="preload" href="{{asset "css/post.css"}}" as="style" />
  <link rel="modulepreload" href="{{asset "js/post.js"}}" />
{{/contentFor}}

{{#contentFor "styles"}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/post.css"}}" media="screen" />
  <link rel="stylesheet" type="text/css" href="{{asset "css/print.css"}}" media="print" />
{{/contentFor}}

{{!< default}}

{{#post}}
  {{> header}}

  {{!-- Single-author rule (docs/guide-auteur.md): no link to the author page when only one author has
  published posts. One query of one row for the whole article (the header and the author box read it from
  authorPages); {{#with ..}} gives the post back as the context inside the block of {{#get}}. --}}
  {{#get "authors" limit="1" fields="id" as |siteAuthors authorPages|}}{{#with ..}}
  <main id="main" class="site-main article-page">
    <article class="article{{#if feature_image}} article--has-image{{/if}}" data-article
      data-style="{{#has tag="#immersif"}}immersive{{else}}{{#has tag="#carte"}}card{{else}}{{#match @custom.article_style "Immersive"}}immersive{{else}}card{{/match}}{{/has}}{{/has}}"
      {{#unless @custom.summary_for_visitors}}data-summary-members{{/unless}}
      data-url="{{url}}" data-title="{{title}}" data-image="{{> "vignette/url"}}" data-tag="{{primary_tag.name}}" data-reading-time="{{reading_time minute="1" minutes="%"}}"
      data-author="{{primary_author.name}}" data-published="{{date format="YYYY-MM-DD"}}"
      data-copy-link="{{t "Copy the link to the section “{title}”" title="{title}"}}" data-link-copied="{{t "Link copied"}}"
      data-copy="{{t "Copy"}}" data-copied="{{t "Copied"}}" data-copy-code="{{t "Copy the code"}}" data-code-copied="{{t "Code copied"}}"
      style="--label-summary: &quot;{{t "In short"}}&quot;; --label-summary-author: &quot;{{t "Author's summary"}}&quot;; --label-summary-ai: &quot;{{t "AI-generated summary"}}&quot;">

      {{#match authorPages.total 1}}{{> article/header soloAuthor=true}}{{else}}{{> article/header}}{{/match}}

      <div class="article-body">
        {{> article/toc}}

        <div class="article-intro" data-article-intro>
          {{> article/series}}
          {{> article/summary-teaser}}
        </div>

        <div class="gh-content article-content js-post-content" data-article-content>
          {{content}}
        </div>

        <footer class="article-end">
          {{> article/dates}}
          {{> article/series-nav}}
          {{> article/share}}
        </footer>
      </div>

      {{#match authorPages.total 1}}{{> article/author soloAuthor=true}}{{else}}{{> article/author}}{{/match}}

      {{!-- Ghost's comments (comments-ui, ~250 KB from jsDelivr) load only when the reader gets near them,
      or at once when the address or a link targets them (#ghost-comments…): src/js/article/comments.js.
      Ghost's own {{comments}} output stays as Ghost writes it, inert inside the <template> until the script
      copies it after #ghost-comments-root (comments-ui draws its frame in that element when it is the
      script's previous sibling; the anchor #ghost-comments-root of Ghost's newsletter works before that).
      data-comments-space: the height kept while loading, the comment form (a member who may comment) or
      Ghost's « sign up / upgrade » invitation (everyone else). Without JavaScript comments-ui cannot run:
      the <noscript> sentence says so. --}}
      {{#if comments}}
        <section class="article-comments container" aria-label="{{t "Member discussion"}}" data-comments
          data-comments-space="{{#if @member}}{{#match @site.comments_access "paid"}}{{#if @member.paid}}form{{else}}invite{{/if}}{{else}}form{{/match}}{{else}}invite{{/if}}"
          data-comments-error="{{t "The comments could not be loaded. Reload the page to try again."}}">
          <div class="article-comments__inner js-native-comments">
            <p class="article-comments__status" role="status" data-comments-status>{{t "Loading comments…"}}</p>
            <div id="ghost-comments-root"></div>
            <template data-comments-script>{{comments title=(t "Member discussion") count=true}}</template>
            <noscript><p class="article-comments__status">{{t "Comments need JavaScript: turn it on to read and write them."}}</p></noscript>
          </div>
        </section>
      {{/if}}
    </article>

    {{> article/related}}

    {{!-- Reading progress ring and back to the top (CSS scroll-driven animation, post.js otherwise) --}}
    <button type="button" class="progress-button js-scrolltop" aria-label="{{t "Scroll to top"}}" data-progress-button>
      {{> "icons/arrow-up"}}
      <svg class="progress-button__ring" aria-hidden="true" viewBox="0 0 100 100">
        <circle class="progress-button__track" cx="50" cy="50" r="47" pathLength="100" />
        <circle class="progress-button__circle js-progress" cx="50" cy="50" r="47" pathLength="100" />
      </svg>
    </button>

    {{#if @member}}{{#if @custom.reading_settings}}{{> article/reading-settings}}{{/if}}{{/if}}
    <p class="sr-only" aria-live="polite" data-article-live></p>
  </main>
  {{/with}}{{/get}}
{{/post}}

{{#contentFor "scripts"}}
  <script type="module" async src="{{asset "js/post.js"}}"></script>
{{/contentFor}}
