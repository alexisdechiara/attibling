{{!--
Tag page: a dressed header (the tag's feature image, name, description, number of posts),
on the first page the tag's lead post (its most recent FEATURED post, else its most recent post), then
the grid of the other posts and the pagination.
Falls back gracefully: no image → plain dark card; no description → no line; no featured post → the
most recent post leads. The lead post is left out of the grid of the first page.
--}}

{{#contentFor "preload"}}
  <link rel="preload" href="{{asset "css/listing.css"}}" as="style" />
{{/contentFor}}

{{#contentFor "styles"}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/listing.css"}}" media="screen" />
{{/contentFor}}

{{!< default}}

{{> header}}

<main id="main" class="site-main listing">
  {{#tag}}
    <div class="container">
      <header class="listing-hero{{#if feature_image}} listing-hero--image{{/if}}" data-tag-header>
        {{#if feature_image}}
          <img class="listing-hero__image" srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 767px) 100vw, 70vw" src="{{img_url feature_image size="l"}}" alt="" fetchpriority="high">
        {{/if}}
        <div class="listing-hero__text">
          <h1 class="listing-hero__title">{{name}}</h1>
          {{#if description}}<p class="listing-hero__description">{{description}}</p>{{/if}}
          <p class="listing-hero__meta">{{plural ../pagination.total empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}} {{t "with this tag"}}</p>
        </div>
      </header>
    </div>
  {{/tag}}

  {{!-- The grid partial gets the page's posts as items: from inside {{#get}} and {{#foreach}} they are
  two levels up. Ghost renders the block of {{#get}} even when nothing matches (its {{else}} is only
  for a failed request): the result is tested with {{#if lead}}. --}}
  {{!-- A tag with a single post: the lead card is all there is, so no « All posts » section under it
  (pagination.total > 1); a tag without any post: the grid's empty state. --}}
  {{#is "paged"}}
    {{> "listing/grid" items=posts title=(t "All posts")}}
  {{else}}
    {{#match pagination.total ">" 0}}
      {{#get "posts" filter="tag:{{tag.slug}}+featured:true" include="tags" limit="1" as |lead|}}
        {{#if lead}}
          {{#foreach lead}}
            {{> "listing/lead"}}
            {{#match ../../pagination.total ">" 1}}{{> "listing/grid" items=../../posts exclude=id title=(t "All posts")}}{{/match}}
          {{/foreach}}
        {{else}}
          {{#foreach ../posts limit="1"}}
            {{> "listing/lead"}}
            {{#match ../../pagination.total ">" 1}}{{> "listing/grid" items=../../posts exclude=id title=(t "All posts")}}{{/match}}
          {{/foreach}}
        {{/if}}
      {{/get}}
    {{else}}
      {{> "listing/grid" items=posts title=(t "All posts")}}
    {{/match}}
  {{/is}}
  {{pagination}}
</main>
