{{!--
Home page and the pages of the post list (/page/2/...).

Page 1 (the "home" context), in this order:
  hero « E2 » (featured posts) → « Derniers articles » (the 7 posts of the page: a lead card and six
  rows) → for visitors the subscription block, for members their « Reprendre la lecture / À lire plus
  tard » lists → « Les plus lus » (posts tagged #top) → rows by tag (see partials/home/rows.hbs).
Page 2 and after: a plain grid of the page's posts with the pagination, no hero.

posts_per_page (package.json) is 7, the number of posts « Derniers articles » shows: page 2 starts
right after them, so its « Tout voir » link loses no post.
--}}

{{#contentFor "preload"}}
  <link rel="preload" href="{{asset "css/home.css"}}" as="style" />
  <link rel="modulepreload" href="{{asset "js/home.js"}}" />
{{/contentFor}}

{{#contentFor "styles"}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/home.css"}}" media="screen" />
{{/contentFor}}

{{!< default}}

{{#is "home"}}
  {{!-- The subscription page is looked up once for the header and the two « S'abonner » buttons of the page
  (subscribe-href.hbs); members have no such button, and the setting subscribe_url needs no lookup. The
  {{#get}} block changes the context: {{#with ..}} gives it back. --}}
  {{#if @member}}
    {{> header home=true}}
    {{> "home/main"}}
  {{else if @custom.subscribe_url}}
    {{> header home=true}}
    {{> "home/main"}}
  {{else}}
    {{#get "pages" filter="slug:[newsletter,abonnement,subscribe]" limit="1" as |subscribepages|}}{{#with ..}}
      {{> header home=true subscribePages=subscribepages subscribePagesKnown=true}}
      {{> "home/main" subscribePages=subscribepages subscribePagesKnown=true}}
    {{/with}}{{else}}
      {{> header home=true}}
      {{> "home/main"}}
    {{/get}}
  {{/if}}
{{else}}
  {{> header}}

  <main id="main" class="site-main home-paged">
    <div class="container">
      <header class="page-heading">
        <h1 class="page-heading__title">{{t "All posts"}}</h1>
        <p class="page-heading__note">{{t "Page {page} of {pages}" page=pagination.page pages=pagination.pages}}</p>
      </header>
      <ul class="post-grid" role="list">
        {{#foreach posts}}
          <li>{{> post-tile size="s" eager=@first heading="h2"}}</li>
        {{else}}
          <li class="latest__empty">{{t "No posts"}}</li>
        {{/foreach}}
      </ul>
    </div>
    {{pagination}}
  </main>
{{/is}}

{{#contentFor "scripts"}}
  <script type="module" async src="{{asset "js/home.js"}}"></script>
{{/contentFor}}
