{{!--
Author page: a dressed header (cover image when the author has one, avatar, name, bio, location and
links, number of posts), then the grid of their posts and the pagination.
Every part is optional: no cover → plain dark card; no avatar → initial on a tinted disc; no bio,
location or links → nothing.
Single-author site (only one author has published posts): the theme links to this page nowhere and the
page asks search engines not to index it (it repeats the home's list; the <meta> is in default.hbs,
as {{contentFor}} cannot be used inside {{#get}}); it still works when reached directly.
docs/guide-auteur.md explains how to redirect it with redirects.yaml.
--}}

{{#contentFor "preload"}}
  <link rel="preload" href="{{asset "css/listing.css"}}" as="style" />
{{/contentFor}}

{{#contentFor "styles"}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/listing.css"}}" media="screen" />
{{/contentFor}}

{{!< default}}

{{> header}}

<main id="main" class="site-main listing">
  {{#author}}
    <div class="container">
      <header class="listing-hero listing-hero--author{{#if cover_image}} listing-hero--image{{/if}}">
        {{#if cover_image}}
          <img class="listing-hero__image"{{> "image/srcset" image=cover_image widths="m-l-xl" srcSize="l"}} sizes="(max-width: 767px) 92vw, (max-width: 1443px) 63vw, 903px" alt="" fetchpriority="high">
        {{/if}}
        <div class="listing-hero__text">
          {{> author-avatar avatarClass="listing-hero__avatar"}}
          <div class="listing-hero__body">
            <h1 class="listing-hero__title">{{name}}</h1>
            {{#if bio}}<p class="listing-hero__description">{{bio}}</p>{{/if}}
            <p class="listing-hero__meta">
              <span>{{plural ../pagination.total empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</span>
              {{#if location}}<span class="listing-hero__location">{{> "icons/map-pin"}}{{location}}</span>{{/if}}
            </p>
            {{> author-links linksClass="listing-hero__links"}}
          </div>
        </div>
      </header>
    </div>
  {{/author}}

  {{> "listing/grid" items=posts title=(t "All posts")}}
  {{pagination}}
</main>
