{
	"name": "attibling",
	"version": "1.2.0",
	"description": "Fusion between liebling and attila themes",
	"author": {
		"email": "pro@alexisdechiara.fr",
		"name": "Alexis De Chiara",
		"url": "https://geekly.blog/"
	},
	"license": "MIT",
	"keywords": [
		"ghost",
		"theme",
		"ghost-theme"
	],
	"engines": {
		"ghost": ">=6.0.0"
	},
	"config": {
		"posts_per_page": 10,
		"card_assets": {
			"exclude": [
				"bookmark",
				"gallery"
			]
		},
		"image_sizes": {
			"xxs": {
				"width": 30
			},
			"xs": {
				"width": 100
			},
			"s": {
				"width": 300
			},
			"m": {
				"width": 600
			},
			"l": {
				"width": 1000
			},
			"xl": {
				"width": 2000
			}
		},
		"custom": {
			"dark_mode_logo": {
				"type": "image"
			},
			"enable_native_search": {
				"type": "boolean",
				"default": true
			},
			"search_api_key": {
				"type": "text"
			},
			"disable_fade_animation": {
				"type": "boolean",
				"default": false
			},
			"use_geekly_logo": {
				"type": "boolean",
				"default": false,
				"group": "homepage"
			}
		}
	},
	"gpm": {
		"type": "theme",
		"categories": [
			"Beautiful",
			"Clean",
			"Magazine",
			"Minimal",
			"Responsive"
		]
	},
	"screenshots": {
		"desktop": "assets/screenshot-desktop.webp",
		"mobile": "assets/screenshot-mobile.webp"
	},
	"scripts": {
		"dev": "vp build --watch",
		"build": "vp build",
		"check": "vp check",
		"test": "vp test",
		"zip": "zip -r attibling.zip . -x '.*' '.*/*' 'node_modules/*' 'src/*' 'attibling.zip' 'package-lock.json' 'vite.config.mjs'",
		"deploy": "vp run build && vp run zip && node src/deploy/index.js",
		"order-locales": "node src/order-locales.js",
		"ghost": "docker compose -f src/docker-compose.yml up",
		"get-database": "curl https://raw.githubusercontent.com/eddiesigner/ghost-db/ghost5.9.4/ghost.db -o src/ghost.db"
	},
	"dependencies": {
		"@tryghost/content-api": "^1.11.21",
		"fitvids": "^2.1.1",
		"fuse.js": "^7.0.0",
		"headroom.js": "^0.12.0",
		"medium-zoom": "^1.1.0",
		"shave": "^5.0.4",
		"swiper": "^11.1.10",
		"tippy.js": "^6.3.7",
		"tocbot": "^4.29.0"
	},
	"devDependencies": {
		"@tryghost/admin-api": "^1.13.12",
		"dotenv": "^16.4.5",
		"playwright": "1.63.0",
		"vite-plus": "1.7.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
		"vitest": "5.1.0"
	}
}
