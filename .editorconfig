# Editor configuration, see https://editorconfig.org (the same rules as the formatter, vite.config.mjs fmt)
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs}]
indent_style = tab
quote_type = double

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[package.json]
indent_style = tab
